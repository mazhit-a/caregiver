{
  "version": 3,
  "notes": [
    "One question per screen. Every option has tags (used by plan-rules.json) and, where relevant, a 'heard' fragment for the 'What we heard' summary.",
    "Placeholders, filled from recipientLabels by the choice in Q1: {recipient} (Mom), {Recipient} (same, capitalized at sentence start), {possessive} (Mom's), {Possessive}, {pronoun} (she), {Pronoun}, {object} (her), {was}, {is}, {has}, {lives}.",
    "Q3 sets the branch: noticing, recent or changing. Copy can change by branch through 'subtitleByBranch'.",
    "Questions marked healthData: no ad trackers on these screens; answers stay in the browser; never put answers in URLs.",
    "Rule: every question must change something the user gets. The 'usedFor' field says what.",
    "v3: the diagnosis question was removed. Q3 already tells us where the family is, and asking for a diagnosis added sensitive data without changing the plan."
  ],
  "recipientLabels": {
    "mom": {
      "recipient": "Mom",
      "possessive": "Mom's",
      "pronoun": "she",
      "object": "her",
      "was": "was",
      "is": "is",
      "has": "has",
      "lives": "lives"
    },
    "dad": {
      "recipient": "Dad",
      "possessive": "Dad's",
      "pronoun": "he",
      "object": "him",
      "was": "was",
      "is": "is",
      "has": "has",
      "lives": "lives"
    },
    "both": {
      "recipient": "your parents",
      "possessive": "your parents'",
      "pronoun": "they",
      "object": "them",
      "was": "were",
      "is": "are",
      "has": "have",
      "lives": "live"
    },
    "in_law": {
      "recipient": "your parent-in-law",
      "possessive": "your parent-in-law's",
      "pronoun": "they",
      "object": "them",
      "was": "was",
      "is": "is",
      "has": "has",
      "lives": "lives"
    },
    "other": {
      "recipient": "your loved one",
      "possessive": "your loved one's",
      "pronoun": "they",
      "object": "them",
      "was": "was",
      "is": "is",
      "has": "has",
      "lives": "lives"
    }
  },
  "branches": {
    "noticing": {
      "label": "Noticing changes, no diagnosis yet"
    },
    "recent": {
      "label": "Diagnosed in the last 6 months"
    },
    "changing": {
      "label": "Diagnosed a while ago, or just home from the hospital"
    }
  },
  "questions": [
    {
      "id": "q1_recipient",
      "type": "single",
      "title": "Who are you caring for?",
      "usedFor": "Name and pronouns in every text of the funnel and the app",
      "options": [
        {
          "id": "mom",
          "label": "My mom",
          "tags": [
            "recipient:mom"
          ]
        },
        {
          "id": "dad",
          "label": "My dad",
          "tags": [
            "recipient:dad"
          ]
        },
        {
          "id": "both",
          "label": "Both of my parents",
          "tags": [
            "recipient:both"
          ]
        },
        {
          "id": "in_law",
          "label": "A parent-in-law",
          "tags": [
            "recipient:in_law"
          ]
        },
        {
          "id": "other",
          "label": "Another relative",
          "tags": [
            "recipient:other"
          ]
        }
      ]
    },
    {
      "id": "q2_age",
      "type": "single",
      "title": "How old is {recipient}?",
      "subtitle": "If you're caring for both parents, pick the older one.",
      "usedFor": "Moves 'Safe home, calmer days' earlier for 75+; quick guide 'After a fall' for 85+",
      "options": [
        {
          "id": "under65",
          "label": "Under 65",
          "tags": [
            "age:under65"
          ]
        },
        {
          "id": "65_74",
          "label": "65–74",
          "tags": [
            "age:65_74",
            "age:65plus"
          ]
        },
        {
          "id": "75_84",
          "label": "75–84",
          "tags": [
            "age:75_84",
            "age:65plus",
            "age:75plus"
          ]
        },
        {
          "id": "85plus",
          "label": "85 or older",
          "tags": [
            "age:85plus",
            "age:65plus",
            "age:75plus"
          ]
        }
      ]
    },
    {
      "id": "q3_situation",
      "type": "single",
      "title": "What's happening right now?",
      "healthData": true,
      "usedFor": "Sets the branch: before / after text, the Module 1 reason, and adds 'Before the diagnosis' for the noticing branch",
      "options": [
        {
          "id": "noticing",
          "label": "I'm noticing changes, but there's no diagnosis yet",
          "branch": "noticing",
          "tags": [
            "branch:noticing",
            "stage:pre"
          ],
          "heard": {
            "slot": "situation",
            "text": "You've noticed changes in {recipient}, but there's no diagnosis yet."
          }
        },
        {
          "id": "recent",
          "label": "{Recipient} {was} diagnosed in the last 6 months",
          "branch": "recent",
          "tags": [
            "branch:recent",
            "stage:early",
            "new_diagnosis"
          ],
          "heard": {
            "slot": "situation",
            "text": "{Recipient} {was} diagnosed in the last few months."
          }
        },
        {
          "id": "changing",
          "label": "The diagnosis was a while ago, and things are changing",
          "branch": "changing",
          "tags": [
            "branch:changing",
            "stage:middle"
          ],
          "heard": {
            "slot": "situation",
            "text": "The diagnosis was a while ago, and things are changing."
          }
        },
        {
          "id": "hospital",
          "label": "{Recipient} just came home from the hospital",
          "branch": "changing",
          "tags": [
            "branch:changing",
            "stage:middle",
            "after_hospital"
          ],
          "heard": {
            "slot": "situation",
            "text": "{Recipient} just came home from the hospital."
          }
        }
      ]
    },
    {
