      "max": 3,
      "title": "Which of these have you noticed lately?",
      "subtitle": "Pick up to 3. You can skip this one.",
      "subtitleByBranch": {
        "noticing": "Pick up to 3. It's okay if you're not sure yet."
      },
      "healthData": true,
      "skippable": true,
      "usedFor": "Moves 'Hard moments' earlier and picks the phrases on the free gift sheet",
      "options": [
