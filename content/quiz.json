    {
      "id": "q10_documents",
      "type": "grid",
      "title": "Which of these does {recipient} have?",
      "subtitle": "It's fine if you're not sure. We'll help you find out.",
      "usedFor": "Moves 'While they can still decide' earlier if papers are missing or unsure",
      "states": [
        {
          "id": "have",
          "label": "Have"
        },
        {
          "id": "missing",
          "label": "Missing"
        },
        {
          "id": "not_sure",
          "label": "Not sure"
        }
      ],
      "rows": [
        {
          "id": "healthcare_proxy",
          "label": "Healthcare proxy",
          "hint": "The person who can make medical decisions if {recipient} can't"
        },
        {
          "id": "financial_poa",
          "label": "Financial power of attorney",
          "hint": "The person who can handle money and bills"
        },
        {
          "id": "hipaa_release",
          "label": "HIPAA release",
          "hint": "Lets doctors share information with you"
        }
      ],
      "derivedTags": [
        {
          "if": "any row is 'missing' or 'not_sure'",
          "add": "need:documents"
        },
        {
          "if": "all rows are 'have'",
          "add": "docs:ready"
        }
      ]
    },
    {
      "id": "q11_confidence",
      "type": "scale",
      "min": 1,
      "max": 5,
      "title": "How prepared do you feel for what's ahead?",
      "minLabel": "Not at all",
      "maxLabel": "Very prepared",
      "storeAs": "confidenceDay0",
      "usedFor": "Plan intro line; moves 'Caring for yourself' earlier if low; start of the progress chart",
      "derivedTags": [
        {
          "if": "value 1-2",
          "add": "confidence:low"
        },
        {
          "if": "value 3",
          "add": "confidence:mid"
        },
        {
          "if": "value 4-5",
          "add": "confidence:high"
        }
      ]
    },
