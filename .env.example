# Postgres connection used by the api (compose service name db)
DATABASE_URL=postgresql+asyncpg://pcn:pcn@db:5432/pcn
# Postgres connection used by pytest (dev override publishes db on 55432)
TEST_DATABASE_URL=postgresql+asyncpg://pcn:pcn@localhost:55432/pcn_test
# Anthropic key for the role-play coach; empty means fallback-only (warning at startup)
ANTHROPIC_API_KEY=
# Coach harness: single_call or parallel_split
COACH_HARNESS=single_call
# Model used by the coach
COACH_MODEL=claude-opus-5-5
# Model for the parent call of parallel_split; empty means the same as COACH_MODEL
COACH_PARENT_MODEL=
# Effort level for the coach model
COACH_EFFORT=low
# Version of the role-play prompt file
COACH_PROMPT_VERSION=1
# Hard timeout for one LLM call, in seconds
LLM_TIMEOUT_SECONDS=12
# Judge model for the eval runner
EVAL_JUDGE_MODEL=claude-opus-5-5
# Stripe TEST key only (sk_test_ or rk_test_); startup refuses anything else
STRIPE_SECRET_KEY=sk_test_dummy
# Stripe webhook signing secret for /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_dummy
# Public URL of the app (Stripe return URLs)
PUBLIC_APP_URL=http://localhost:3000
# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:3000
# Enables /api/demo controls (true on the hackathon deploy)
DEMO_CONTROLS=true
# Role-play turns allowed per session per hour
ROLEPLAY_TURNS_PER_HOUR=40
